# =============================================================================
# Autonomous RevOps Agent — Backend Environment Configuration Example
# Copy this file to .env and fill in the appropriate values.
# NEVER commit the actual .env file or real credentials to source control.
# =============================================================================

# Server & Network Configuration
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/revops_db?sslmode=require
FRONTEND_URL=http://localhost:3000

# Demo & Safety Controls
# When REVOPS_DEMO_MODE=true, mock email & calendar signals are merged for all 10 seed companies.
REVOPS_DEMO_MODE=true
# When DRY_RUN=true, approved actions simulate execution without dispatching real external network requests.
# Keep DRY_RUN=true by default during seeding and local development.
DRY_RUN=true

# Email Safeguards & Destination Controls
# Server-side restrictions ensure real emails are only ever routed to this verified test address.
TEST_RECIPIENT_EMAIL=your_test_email@example.com
GMAIL_ALLOWED_RECIPIENTS=your_test_email@example.com

# -----------------------------------------------------------------------------
# HubSpot CRM Configuration
# -----------------------------------------------------------------------------
# HUBSPOT_ACCESS_TOKEN: Private app access token used by backend/seed/seed-hubspot-data.js
# to seed companies, contacts, deals, and associations. If not provided, the seeder
# falls back to deterministic offline simulation IDs for zero-credential demos.
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Composio Tool Calling & Live Agent Connections
# -----------------------------------------------------------------------------
# Composio handles runtime integrations for HubSpot, Gmail, and Google Calendar toolkits.
COMPOSIO_API_KEY=ak_your_composio_api_key
COMPOSIO_USER_ID=your_composio_user_id
COMPOSIO_GMAIL_ACCOUNT_ID=ca_your_gmail_connected_account
COMPOSIO_CALENDAR_ACCOUNT_ID=ca_your_calendar_connected_account

# -----------------------------------------------------------------------------
# PostHog Product Usage Telemetry
# -----------------------------------------------------------------------------
# POSTHOG_API_KEY: Project API Key (phc_...) used for batch event ingestion by the seeder.
# POSTHOG_PERSONAL_API_KEY: Personal API Key (phx_...) used by the orchestrator for HogQL analytics queries.
# POSTHOG_PROJECT_ID: PostHog numeric project ID.
# POSTHOG_HOST: Host URL (default: https://us.posthog.com or https://eu.posthog.com).
POSTHOG_API_KEY=phc_your_project_key
POSTHOG_PERSONAL_API_KEY=phx_your_personal_query_key
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://us.posthog.com

# -----------------------------------------------------------------------------
# AI Reasoning & Insights Engine
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# Google OAuth Direct Integration (Optional / Fallback to Composio)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
